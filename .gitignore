# Xcode / SwiftPM
.build/
DerivedData/
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
.swiftpm/
xcuserdata/
*.xcuserstate

# Python
Tools/.venv/
__pycache__/
*.pyc

# Model weights and caches (git-lfs tracked separately once configured)
Tools/.cache/
Models/*.mlpackage/
Models/*.mlmodelc/

# Secrets
.env
credentials.env

# Loop sentinel is deliberately NOT ignored - it is version-controlled state
# HALT

# macOS
.DS_Store

# Claude Code session transcripts.
#
# Two of these were committed and had to be taken out of the history before the first push:
# they land in the working directory named for the date and the prompt that started the
# session, so they do not look like transcripts in a `git status` listing.
.claude/transcripts/
20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*.txt

# Trajectories are copied into the app target at build time from Apps/Shared/Resources
Apps/PhoneFold/Resources/*.pftraj

# Compiled prototype binaries
Tools/go_model_fold_bin

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- PhoneFold collects nothing. Every fold runs on the device and no sequence,
	     structure, film or piece of music leaves it unless the person exports one
	     themselves. There are no analytics SDKs and no network calls except the
	     AlphaFold Database fetch the user asks for by typing an accession, and the
	     user's own iCloud, which carries a list of the folds they have run between
	     their own devices and reaches nobody else's. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults, for two things, and they need two different reasons.

		     CA92.1 is "access info from same app": one flag for whether the
		     introduction has been seen.

		     1C8F.1 is "access info from an app group or an app extension of the
		     same app", and it was added on 2026-08-31 when the Watch complication
		     landed. FoldComplicationStore writes the last state the phone
		     published into group.com.mdeller.phonefold so the complication - a
		     separate process WidgetKit wakes on its own schedule - can read it.
		     That is no longer "same app", and a manifest that still said CA92.1
		     would be inaccurate rather than merely incomplete. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
